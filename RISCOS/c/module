_kernel_oserror *SWI_Info(int swi, _kernel_swi_regs *r, void *pw)
{
    if (r->r[0] != 0) {
        return err_BadFlags;
    }

    r->r[0] = 0;
    r->r[1] = 40;
    r->r[2] = 177;
    r->r[3] = (1 << MAKEQRCODE_FORMAT_SPRITE_FILE) |
              (1 << MAKEQRCODE_FORMAT_SPRITE) |
              (1 << MAKEQRCODE_FORMAT_BITMAP);
    r->r[4] = 64 + 3918;
    return NULL;
}
