_kernel_oserror *SWI_Sprite(int swi, _kernel_swi_regs *r, void *pw)
{
    unsigned int out_len;
    unsigned int width;
    unsigned int height;
    _kernel_oserror *err;

    out_len = (unsigned int)r->r[4];
    width = 0;
    height = 0;

    err = makeqrcode_sprite((unsigned int)r->r[0],
                            (const char *)r->r[1],
                            (const void *)r->r[2],
                            (void *)r->r[3],
                            &out_len,
                            &width,
                            &height);
    r->r[1] = (int)width;
    r->r[2] = (int)height;
    r->r[4] = (int)out_len;
    return err;
}


