/***************************************************************************
 * Function:     Mod_Init
 * Description:  Initialise the module.
 * Parameters:   tail        = pointer to command line
 *               podule_base = address of podule module was started from
 *               pw          = private word for module
 * On exit:      Return NULL for successful initialisation.
 **************************************************************************/
_kernel_oserror *Mod_Init(const char *tail, int podule_base, void *pw)
{
    dprintf("Module MakeQRCode initialised\n");
    return NULL;
}


/***************************************************************************
 * Function:     Mod_Final
 * Description:  Finalise the module.
 * Parameters:   fatal       = fatality indicator
 *               podule_base = address of podule module was started from
 *               pw          = private word for module
 * On exit:      Return NULL for successful finalisation.
 **************************************************************************/
_kernel_oserror *Mod_Final(int fatal, int podule_base, void *pw)
{
    dprintf("Module MakeQRCode dying\n");
    return NULL;
}


_kernel_oserror *SWI_Sprite(int swi, _kernel_swi_regs *r, void *pw)
{
    unsigned int out_len;
    unsigned int width;
    unsigned int height;
    _kernel_oserror *err;

    out_len = (unsigned int)r->r[4];
    width = 0;
    height = 0;

    err = makeqrcode_sprite((unsigned int)r->r[0],
                            (const char *)r->r[1],
                            (const void *)r->r[2],
                            (void *)r->r[3],
                            &out_len,
                            &width,
                            &height);
    r->r[1] = (int)width;
    r->r[2] = (int)height;
    r->r[4] = (int)out_len;
    return err;
}


